rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'rohit37816@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    match /users/{userId} {
      // Anyone can read users for the leaderboard
      allow read: if true;
      // Users can create and update their own profile; Admins can update/delete
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      // Anyone can read categories
      allow read: if true;
      // Only admins can write
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      // Anyone can read quizzes
      allow read: if true;
      // Only admins can write
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      // Anyone can read global settings (such as quiz marking rules)
      allow read: if true;
      // Only admins can update settings
      allow write: if isAdmin();
    }
  }
}
