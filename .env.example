# Gemini API Key for Server & Vercel Serverless Functions
# Example: GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=

# Client-side Gemini API Key for Vite / Vercel Static Frontend (Recommended on Vercel)
# Example: VITE_GEMINI_API_KEY=AIzaSy...
VITE_GEMINI_API_KEY=

# MongoDB Connection URI (optional - defaults to cloud cluster)
MONGODB_URI=

