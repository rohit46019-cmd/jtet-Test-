{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|manifest.json|sw.js|icon.jpg|logo.jpg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
